[
    {
        "entity": "agent",
        "message": "start-router",
        "params": {
            "default-route": "192.168.0.1",
            "interfaces": [
                {
                    "dev_id": "__INTERFACE_1__dev_id",
                    "dhcp": "yes",
                    "type": "wan",
                    "wanNatAddresses": ["1.2.3.4"]
                },
                {
                    "dev_id": "__INTERFACE_2__dev_id",
                    "dhcp": "yes",
                    "type": "wan"
                },
                {
                    "dev_id": "__INTERFACE_3__dev_id",
                    "dhcp": "yes",
                    "type": "lan"
                }
            ]
        }
    },
    {
        "entity": "agent",
        "message": "add-firewall-policy",
        "params": {
            "inbound": {
                "portForward": {
                    "rules": [
                        {
                            "id": "1",
                            "classification": {
                                "destination": {
                                    "interface" : "__INTERFACE_1__dev_id",
                                    "ip4Address": "1.2.3.4",
                                    "protocols": [
                                        "tcp",
                                        "udp"
                                    ],
                                    "ports": "5589-5591"
                                },
                                "source": {
                                    "ipPort": {
                                        "ip": "12.12.12.1/32"
                                    }
                                }
                            },
                            "action": {
                                "internalIP": "10.0.0.1",
                                "internalPortStart": 8001
                            }
                        }
                    ]
                }
            }
        }
    }
]
