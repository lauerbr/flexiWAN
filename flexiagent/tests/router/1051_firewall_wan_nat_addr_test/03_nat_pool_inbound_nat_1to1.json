[
    {
        "entity": "agent",
        "message": "start-router",
        "params": {
            "default-route": "192.168.0.1",
            "interfaces": [
                {
                    "dev_id": "__INTERFACE_1__dev_id",
                    "dhcp": "yes",
                    "type": "wan",
                    "wanNatAddresses": ["11.11.11.11"]
                },
                {
                    "dev_id": "__INTERFACE_2__dev_id",
                    "dhcp": "yes",
                    "type": "wan"
                },
                {
                    "dev_id": "__INTERFACE_3__dev_id",
                    "dhcp": "yes",
                    "type": "lan"
                }
            ]
        }
    },
    {
        "entity": "agent",
        "message": "add-firewall-policy",
        "params": {
            "inbound": {
                "nat1to1": {
                    "rules": [
                        {
                            "id": "1",
                            "classification": {
                                "destination": {
                                    "interface"  : "__INTERFACE_1__dev_id",
                                    "ip4Address" : "11.11.11.11"
                                }
                            },
                            "action": {
                                "internalIP": "10.0.0.1"
                            }
                        }
                    ]
                }
            }
        }
    }
]